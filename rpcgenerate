        print(f"Usage: {sys.argv[0]} <idlfilename>", file=sys.stderr)


def writeCommonSupportFunctions(filename):
    with open(filename, "w", encoding="utf-8") as file:
        file.write(getCommonSupportFunctions(filename, "RPCSTUBSOCKET"))

def generateStructSendReceiveFuncs(type_pair, is_array, types):
    type_name = type_pair[0]
    
    get_decl = f"{type_name} get_{type_name}_from_stream();\n"
    send_decl = f"void send_{type_name}_to_stream({type_name} to_send);\n"

    get_func = get_decl[:-2] + f"\n{{\n{SPACE + type_name} to_get;\n"
    send_func = send_decl[:-2] + f"\n{{\n"
    
    for member in type_pair[1]['members']:
        #TODO: make loop for array
        # if types[member['name']][1]["type_of_type"] == "array":
        #     # call special array function name (dont use the normal name) run and hide
        get_func += SPACE + f"to_get.{member['name']} = get_{member['type']}_from_stream();\n"
        send_func += SPACE + f"send_{member['type']}_to_stream(to_send.{member['name']});\n"

    get_func += SPACE + f"return to_get;\n}}\n"
    send_func += f"}}\n"

    to_return = {
        "get_func" : get_func, 
        "send_func" : send_func, 
        "get_decl" : get_decl, 
        "send_decl" : send_decl
    }
    return to_return

def generateArraySendReceiveFuncs(type_pair, is_array, types):
    member_type = type_pair[1]['member_type']
    element_count = type_pair[1]['element_count']
    for_loop = SPACE + f"for (int i = 0; i < {element_count}; i++) {{\n"

    get_decl = f"void get_{member_type}_{element_count}_from_stream({member_type} *to_get);\n"
    send_decl = f"void send_{member_type}_{element_count}_to_stream({member_type} *to_send);\n"

    get_func = get_decl[:-2] + f"\n{{\n" + for_loop
    send_func = send_decl[:-2] + f"\n{{\n" + for_loop

    if is_array[member_type]:
        # write call to special array functions
        get_func += SPACE + SPACE + f"get_{types[member_type]['member_type']}_{types[member_type]['element_count']}_from_stream();\n"
        send_func += SPACE + SPACE + f"send_{types[member_type]['member_type']}_{types[member_type]['element_count']}_to_stream(to_send[i]);\n"
    else:
        # write call to normal functions
        get_func += (SPACE * 2) + f"to_get[i] = get_{member_type}_from_stream();\n"
        send_func += (SPACE * 2) + f"send_{member_type}_to_stream(to_send[i]);\n"

    
    get_func += SPACE + f"}}\n}}\n"
    send_func += SPACE + f"}}\n}}\n"

    to_return = {
        "get_func" : get_func, 
        "send_func" : send_func, 
        "get_decl" : get_decl, 
        "send_decl" : send_decl
    }
    return to_return

__main__()