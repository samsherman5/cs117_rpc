#!/bin/env python3

import subprocess
import json
import sys
import os
import re

IDL_TO_JSON_EXECUTABLE = './idl_to_json'

SPACE = "    "

COMMON_SUPPORT_DECLS = f"""
void get_string_from_stream(string *string_p);
void get_float_from_stream(float *float_p);
void get_int_from_stream(int *int_p);
void send_string_to_stream(string s);
void send_int_to_stream(int i);
void send_float_to_stream(float f);

#define INITIAL_BUFF_SIZE 50
"""

# WILL NOT CHANGE ONCE POPULATED
types = {}     # will be populated with decls["types"]
functions = {} # will be populated with decls["functions"]

def __main__(): 
    # try:
    #     Make sure invoked properly
    assert len(sys.argv) == 2, "Wrong number of arguments"

    #     Make sure IDL file exists and is readable
    filename = sys.argv[1]
    assert os.path.isfile(filename), f"Path {filename} does not designate a file"
    assert os.access(filename, os.R_OK), f"File {filename} is not readable" 

    #     Make sure idl_to_json exists and is executable
    assert os.path.isfile(IDL_TO_JSON_EXECUTABLE), f"Path {IDL_TO_JSON_EXECUTABLE} does not designate a file...run \"make\" to create it" 
    assert os.access(IDL_TO_JSON_EXECUTABLE, os.X_OK), f"File {IDL_TO_JSON_EXECUTABLE} exists but is not executable"

    #     Parse declarations into a Python dictionary
    decls = json.loads(subprocess.check_output([IDL_TO_JSON_EXECUTABLE, filename]))
    global types
    types = decls['types']
    global functions
    functions = decls['functions']

    idlName = filename.split(".")[0]

    is_array = {}
    for ty in decls['types'].items():
        if ty[1]['type_of_type'] == "array":
            is_array[ty[0]] = True
        else:
            is_array[ty[0]] = False

    # Based on the IDL, create specific get_x_from_stream and send_x_to_stream functions and declarations
    file_decls = ""
    file_funcs = ""
    for ty in decls["types"].items():
        # if type is struct
        if ty[1]["type_of_type"] == "struct":
            funcs = generateStructSendReceiveFuncs(ty, is_array)
            file_decls += funcs['get_decl'] + funcs['send_decl']
            file_funcs += funcs['get_func'] + funcs['send_func']
        # if type is array 
        if ty[1]["type_of_type"] == "array":
            funcs = generateArraySendReceiveFuncs(ty)
            file_decls += funcs['get_decl'] + funcs['send_decl']
            file_funcs += funcs['get_func'] + funcs['send_func']

    # Based on the IDL, create specific functions
    for func in decls["functions"].items():
        func_struct = generateProxyFunc(func, filename)
        file_decls += func_struct['decl']
        file_funcs += func_struct['func']

    # Build complete stub and proxy 
    file_stub = COMMON_SUPPORT_DECLS + file_decls + file_funcs + getCommonSupportFunctions(filename, "RPCSTUBSOCKET")
    file_proxy = COMMON_SUPPORT_DECLS + file_decls + file_funcs + getCommonSupportFunctions(filename, "RPCPROXYSOCKET")
                
    writeString(idlName + ".stub.cpp", file_stub)
    writeString(idlName + ".proxy.cpp", file_proxy)
    # except Exception as e:
    #     print(str(e), file=sys.stderr)
    #     print(f"Usage: {sys.argv[0]} <idlfilename>", file=sys.stderr)

def writeString(filename, file_contents):
    with open(filename, "w", encoding="utf-8") as file:
        file.write(file_contents)

def generateProxyFunc(func, filename):
    """
    generateProxyFunc
    
    purpose: generate the functions in the {filename}.proxy.cpp file
    
    args: 
        ty:         a list of functions
        filename:   the name of the file
    
    returns: 
        body:   the body of the function as a string
        decl:   the declaration of the function as a string
    """

    func_name = func[0]
    print(func[1])
    return_type = func[1]['return_type']

    decl = f"{return_type} {func_name}("
    body = f"""
{{
    /* send remote call */
    c150debug->printf(C150RPCDEBUG,'{filename}.proxy.cpp: {func_name}() invoked');
    
    /* write argument */
    send_string_to_stream("{func[0]}");

    """
    # send the arguments to the stream 
    for i, arg in enumerate(func[1]['arguments']):
        decl += f"{arg['type']} {arg['name']}, "
        body += f"send_{getSanitizedTypeName(arg['type'])}_to_stream({arg['name']})\n\n"
        if i == len(func[1]['arguments']) - 1:
            decl = decl[:-2]
    decl += f");\n\n"

    # add debug
    body += SPACE + f"c150debug->printf(C150RPCDEBUG,\"{filename}.proxy.cpp: {func_name}() invocation sent, waiting for response\");\n"

    # get the return value from the stream
    body += SPACE + f"{func[1]['return_type']} return_value;\n"
    body += SPACE + f"get_{getSanitizedTypeName(return_type)}_from_stream(&return_value);\n"

    # add debug 
    body += SPACE + f"c150debug->printf(C150RPCDEBUG,\"{filename}.proxy.cpp: {func_name}() successful return from remote call\");\n"
    
    # return statement and closing parenthesis 
    body += SPACE + f"return result_value;\n"
    body += f"}}\n"

    # put the body together, like frankenstein!
    body = decl[:-2] + body

    return {
        'func': body,
        'decl': decl
    }

def getSanitizedTypeName(type_name):
    """
    getSanitizedTypeName

    purpose: gets the type name of a type in the sanitized format: 
        ex. int -> int
        ex. __int[10] -> int_10
        ex. __rectangle[40][15] -> rectangle_40_15

    arguments: 
        type_name:   the name of the type

    returns: 
        a string, the sanitized type name
    """
    type_of_type = types[type_name]['type_of_type']

    # if the type is an array, build the type name from the size of the inner arrays
    if type_of_type == "array":
        sanitized_name = re.findall(r"__([a-zA-Z0-9]+)", type_name)[0]
        sizes = re.findall(r"\[(\d+)\]", type_name)
        for size in sizes: 
            sanitized_name += f"_{size}"
    # otherwise, just return the type name 
    else:
        sanitized_name = type_name

    return sanitized_name
    

def generateStructSendReceiveFuncs(type_pair, is_array):
    """
    generateStructSendReceiveFuncs
    
    purpose: generates the declaration and implementation functions for
             sending and receiving types from the stream 
             
    args: 
        type_pair:  the name of the type and the type of type
        is_array:   a boolean array that signifies if a type is an array 
        
    returns: 
        get_func:   the function implementation of getting a type from stream
        send_func:  the function implementation of sending a type to stream 
        get_decl:   the declaration of the function that gets a type from stream
        send_decl:  the declaration of the function that sends a type to stream
    """
    type_name = type_pair[0]
    
    get_decl = f"void get_{type_name}_from_stream({type_name} *struct_p);\n"
    send_decl = f"void send_{type_name}_to_stream({type_name} to_send);\n"

    get_func = get_decl[:-2] + f"\n{{\n"
    send_func = send_decl[:-2] + f"\n{{\n"
    
    for member in type_pair[1]['members']:
        sanitized_type = getSanitizedTypeName(member['type'])
        # If array, make sure all nested arrays are accounted for
        if is_array[member['type']]:
            get_func += SPACE + f"get_{sanitized_type}_from_stream(struct_p->{member['name']});\n"
            send_func += SPACE + f"send_{sanitized_type}_to_stream(to_send.{member['name']});\n"
        # Otherwise, create normal call 
        else:
            get_func += SPACE + f"get_{sanitized_type}_from_stream(&(struct_p->{member['name']}));\n"
            send_func += SPACE + f"send_{sanitized_type}_to_stream(to_send.{member['name']});\n"

    get_func += f"}}\n"
    send_func += f"}}\n"

    to_return = {
        "get_func" : get_func, 
        "send_func" : send_func, 
        "get_decl" : get_decl, 
        "send_decl" : send_decl
    }
    return to_return

def generateArraySendReceiveFuncs(type_pair):
    member_type = type_pair[1]['member_type']
    element_count = type_pair[1]['element_count'] # number of elements in the array 
    for_loop = SPACE + f"for (int i = 0; i < {element_count}; i++) {{\n"
    base_type = re.findall(r"__([a-zA-Z0-9]+)", type_pair[0])[0] # base type of the array 
    sizes = re.findall(r"\[(\d+)\]", type_pair[0])
    num_nests = type_pair[0].count("[") # number of times to pass by reference 

    sanitized_type = getSanitizedTypeName(type_pair[0])
    
    ### Generate send and receive declarations
    get_decl = f"void get_{sanitized_type}_from_stream({base_type} {'*'* (num_nests)}arr_p);\n"
    send_decl = f"void send_{sanitized_type}_to_stream({base_type} {'*' * num_nests}to_send);\n"

    ### Generate send and receive functions

    # steal definition signature from declaration
    get_func = get_decl[:-2] + f"\n{{\n" + for_loop
    send_func = send_decl[:-2] + f"\n{{\n" + for_loop

    # build body of for loop
    sanitized_member_type = getSanitizedTypeName(member_type)
    get_func += SPACE + SPACE + f"get_{sanitized_member_type}_from_stream(arr_p + i);\n"
    send_func += SPACE + SPACE + f"send_{sanitized_member_type}_to_stream(to_send[i]);\n"

    get_func += SPACE + f"}}\n}}\n"
    send_func += SPACE + f"}}\n}}\n"

    to_return = {
        "get_func" : get_func, 
        "send_func" : send_func, 
        "get_decl" : get_decl, 
        "send_decl" : send_decl
    }
    return to_return

def getCommonSupportFunctions(filename, socketname):
    """
    getCommonSupportFunctions
    
    purpose: generates the string that holds the common support func
    """
    
    COMMON_SUPPORT_FUNCTIONS = f"""
// ======================================================================
//
//                        COMMON SUPPORT FUNCTIONS
//
// ======================================================================

/*  get_float_from_stream 

    gets a float from the stream
    
    args: 
        float pointer
        
    returns: 
        void

    notes: 
        uses getStringFromStream() 
        
*/
void get_float_from_stream(float *float_p)
{{
    string to_get;
    get_string_from_stream(&to_get);
    float floatFromStream = stof(to_get);

    *float_p = floatFromStream;
}}

/*  get_int_from_stream 

    gets an int from the stream
    
    args: 
        int pointer
        
    returns: 
        n/a

    notes: 
        uses getStringFromStream() 
        
*/
void get_int_from_stream(int *int_p)
{{
    string to_get;
    get_string_from_stream(&to_get);
    int intFromStream = stoi(to_get);

    *int_p = intFromStream;
}}

//                   get_string_from_stream
//
//   Helper routine to read a string from the stream. 
//   Note that this code is the same for all stubs, so can be generated
//   as boilerplate.
//
//   Important: this routine must leave the sock open but at EOF
//   when eof is read from client.
void get_string_from_stream(string *string_p) 
{{
    unsigned i = 0;
    char *bufp = (char *)malloc(INITIAL_BUFF_SIZE); // allocate memory for buffer
    assert(bufp != NULL);
    bool readnull;
    ssize_t readlen;                        // amount of data read from socket
    unsigned bufSize = INITIAL_BUFF_SIZE;

    // Read a message from the stream
    // -1 in size below is to leave room for null
    readnull = false;
    while(!readnull) {{
        /* expand buffer if necessary */
        if (i == (bufSize - 1)) {{
            bufSize *= 2;
            char *new_buf = (char *)realloc(bufp, bufSize);
            assert(new_buf != NULL);
            bufp = new_buf;
        }}

        /* read a byte into the buffer from the stream */
        readlen = {socketname}->read(bufp + i, 1);
        
        /* check for EOF or error */
        if (readlen == 0) {{
            break;
        }}

        /* check for NULL terminator */
        if (*(bufp + i) == \'\\0\') {{
            readnull = true;
            break;
        }}

        /* increment i for next iteration*/
        i++;
    }}

    
    // With TCP streams, we should never get a 0 length read
    // except with timeouts (which we're not setting in pingstreamserver)
    // or EOF
    if (readlen == 0) {{
        c150debug->printf(C150RPCDEBUG,"{filename}: read zero length message, checking EOF");
        if ({socketname}-> eof()) {{
            c150debug->printf(C150RPCDEBUG,"{filename}: EOF signaled on input");

        }} else {{
            throw C150Exception("{filename}: unexpected zero length read without eof");
        }}
    }}
    // If we didn't get a null, input message was poorly formatted
    else if(!readnull) 
        throw C150Exception("{filename}: string not null terminated or too long");

    
    string buffer(bufp);
    free(bufp);

    *string_p = buffer;
}}

/* 
                SEND TO STREAM FUNCTIONS 
*/

void send_string_to_stream(string s)
{{
    {socketname}->write(s.c_str(), s.length()+1);
}}

void send_int_to_stream(int i)
{{
    send_string_to_stream(to_string(i));
}}

void send_float_to_steram(float f)
{{
    send_string_to_stream(to_string(f));
}}
"""
    return COMMON_SUPPORT_FUNCTIONS

__main__()